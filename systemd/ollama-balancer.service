[Unit]
Description=Ollama Unified Load Balancer (nginx)
After=network.target

[Service]
User=nginx
Group=nginx
EnvironmentFile=-/etc/ollama/balancer/ollama-balancer.env
ExecStart=/usr/sbin/nginx -g "daemon off;" -c /etc/ollama/balancer/nginx.conf
Restart=always
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
